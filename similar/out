uer": null, "order": null, "sys_created_by": "data.transfer", "sys_created_on": "2024-03-13 23:37:00", "sys_id": "bf53936387bc461042d3ca260cbb3504", "sys_updated_by": "data.transfer", "sys_updated_on": "2024-03-13 23:37:00"}], "award_class_criteria": null, "award_designation": null, "award_titles": null, "broad_type": null, "career_opportunities": "<p>Depending on the major selected, career options include a wide variety of positions in the IT industry, including business intelligence expert, e-business developer, games developer, information systems manager, IT security analyst, IT security manager, ICT security analyst, IT security consultant, pen testing, IT project manager, movie animator, software architect, software quality/testing specialist and systems analyst.</p>", "cd_assessment": null, "class_name": "Course", "classification_scheme": null, "code": "C04296", "code_number": null, "code_prefix": null, "code_suffix": null, "codes": [{"applies_to_all_offerings": true, "code": "084254E", "ext_id": null, "offerings": [], "status": null, "subtype": null, "sys_created_by": "forbes.chenh", "sys_created_on": "2024-05-28 00:51:45", "sys_id": "8eb3313f1bdec690adfddc69b04bcb9b", "sys_updated_by": "forbes.chenh", "sys_updated_on": "2024-05-28 00:51:45", "type": {"active": true, "label": "CRICOS", "value": "cricos", "sys_id": "0fad592ddbd4b7400595c4048a9619d9", "type": "choice"}, "type_ref": null}], "combinable": false, "course_learning_outcome": [{"code": "CILO4", "description": "<p>Master of Information Technology (Extension) graduates research and evaluate concepts and theories and synthesise concepts in Information Technology and its different areas of practice and design (Software, Hardware, Networking and IT related areas), predict and judge the impacts of IT/IS solutions using ethical, social, commercial and environmental metrics of success.</p>", "element": null, "lo_domain": [], "number": 4, "sys_created_by": "data.transfer", "sys_created_on": "2024-03-14 02:59:28", "sys_id": "21b10cbb87b0861042d3ca260cbb351c", "sys_updated_by": "data.transfer", "sys_updated_on": "2024-03-14 02:59:28", "learning_outcome_element": []}, {"code": "CILO2", "description": "<p>Master of Information Technology (Extension) graduates engage and influence a broad range of diverse stakeholders to develop a shared understanding of IT related values, needs, and priorities, identify and evaluate performance requirements (such as social, environmental, capital expense, safety, operational, maintenance, and reliability, quality and cost effectiveness) of novel technological problems and their impact on society.</p>", "element": null, "lo_domain": [], "number": 2, "sys_created_by": "data.transfer", "sys_created_on": "2024-03-14 02:59:28", "sys_id": "25b10cbb87b0861042d3ca260cbb351b", "sys_updated_by": "data.transfer", "sys_updated_on": "2024-03-14 02:59:28", "learning_outcome_element": []}, {"code": "CILO6", "description": "<p>Master of Information Technology (Extension) graduates self-review their own competence to practice proficiently, anticipate consequences of intended actions or inaction and identify ethical dilemmas when they arise, seek and provide constructive reviews to improve themselves and their teams, to ensure currency in their technological skills.</p>", "element": null, "lo_domain": [], "number": 6, "sys_created_by": "data.transfer", "sys_created_on": "2024-03-14 02:59:28", "sys_id": "2db10cbb87b0861042d3ca260cbb351c", "sys_updated_by": "data.transfer", "sys_updated_on": "2024-03-14 02:59:28", "learning_outcome_element": []}, {"code": "CILO1", "description": "<p>Master of Information Technology (Extension) graduates are culturally and historically well informed, able to co-design projects as respectful professionals when working in and with Aboriginal and Torres Strait Islander communities.</p>", "element": null, "lo_domain": [], "number": 1, "sys_created_by": "data.transfer", "sys_created_on": "2024-03-14 02:59:28", "sys_id": "6db10cbb87b0861042d3ca260cbb351a", "sys_updated_by": "data.transfer", "sys_updated_on": "2024-03-14 02:59:28", "learning_outcome_element": []}, {"code": "CILO5", "description": "<p>Master of Information Technology (Extension) graduates communicate in a variety of ways (accurate and active listening, dialogue, reading, writing, negotiating and contractually) to coordinate, manage and lead diverse teams and projects, collaborate formally and informally to engage, influence and manage stakeholders and in the design of systems.</p>", "element": null, "lo_domain": [], "number": 5, "sys_created_by": "data.transfer", "sys_created_on": "2024-03-14 02:59:28", "sys_id": "a5b10cbb87b0861042d3ca260cbb351c", "sys_updated_by": "data.transfer", "sys_updated_on": "2024-03-14 02:59:28", "learning_outcome_element": []}, {"code": "CILO3", "description": "<p>Master of Information Technology (Extension) graduates apply design thinking, decision making methodologies and technologically related practices to propose IT solutions and implementation strategies for those solutions, exercise judgement to evaluate and respond to system sustainability, constraints, risks, conflicts and uncertainties (social, economic and environmental) in solution design.</p>", "element": null, "lo_domain": [], "number": 3, "sys_created_by": "data.transfer", "sys_created_on": "2024-03-14 02:59:28", "sys_id": "a9b10cbb87b0861042d3ca260cbb351b", "sys_updated_by": "data.transfer", "sys_updated_on": "2024-03-14 02:59:28", "learning_outcome_element": []}], "course_offering": [{"admission_calendar": {"active": true, "label": "Autumn Session", "value": "AUT", "sys_id": "3ed8d3921b364510212465fa274bcba1", "type": "choice"}, "attendance_type": [{"active": true, "label": "NA", "value": "NA", "sys_id": "d47dcec71b7101102b40c1f61a4bcb35", "type": "choice"}], "clarification_to_appear_in_handbook": null, "comments": null, "display_name": "INT-U-AUT", "duration": null, "end_date": null, "entry_point": false, "ext_id": null, "intake_quot