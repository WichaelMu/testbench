            "Type": "Pass",
            "Next": "NoRLGet-Reading-Lists-For-CourseId"
          },
          "NoRLGet-Reading-Lists-For-CourseId": {
            "Parameters": {
              "ApiEndpoint.$": "States.Format('https://data.curriculum.dev.mesh.uts.edu.au/libraries/leganto/courses/{}/reading-lists', $.CourseCode.Id)",
              "Authentication": {
                "ConnectionArn.$": "$.Statics.ConnectionArn"
              },
              "Headers": {
                "Accept": "application/json"
              },
              "Method": "GET"
            },
            "Resource": "arn:aws:states:::http:invoke",
            "ResultPath": "$.OutNoRLPostRL",
            "ResultSelector": {
