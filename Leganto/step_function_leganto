            },
            "End": true
          },
          "NoRLExit-State-Machine": {
            "Type": "Pass",
            "Parameters": {
              "ExitType": "Exit-State-Machine",
              "Message": "This Step Function has been ordered to Exit. This is likely because an impossible scenario suddenly became possible, or an unhandled error occurred."
            },
            "End": true
          },
          "NoRLExit-Safe": {
            "Type": "Pass",
            "Parameters": {
              "ExitType": "Safe",
              "Message": "This Step exited correctly."
            },
            "End": true
          }
        }
      },
      "ItemsPath": "$.study_package_codes",
      "Parameters": {
