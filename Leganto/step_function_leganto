            "Type": "Task",
            "Next": "NoRLValidate-Subject"
          },
          "NoRLValidate-Subject": {
            "Choices": [
              {
                "And": [
                  {
                    "IsPresent": true,
                    "Variable": "$.NoRLSubjects.Count"
                  },
                  {
                    "NumericGreaterThan": 0,
                    "Variable": "$.NoRLSubjects.Count"
