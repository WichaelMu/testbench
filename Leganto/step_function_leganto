            "ResultPath": "$.FoundSearchCode",
            "Type": "Map",
            "Next": "NoRLContains-True"
          },
          "NoRLContains-True": {
            "Comment": "A dumb trick to see if an RL array contains at least one non-null value. I.e., find the pre-existing ReadingList.Id.",
            "Parameters": {
              "Length.$": "States.ArrayLength(States.ArrayUnique($.FoundSearchCode))",
              "ZerothElement.$": "States.ArrayGetItem(States.ArrayUnique($.FoundSearchCode), 0)"
            },
            "ResultPath": "$.DetermineSetValueNoRL",
            "Type": "Pass",
            "Next": "NoRLDetermine-Set"
          },
          "NoRLDetermine-Set": {
            "Comment": "A dumb trick cont. Make the array Unique. If the unique array length is 1, we didn't find the pre-existing ReadingList.Id. If 2, we found it!",
            "Choices": [
              {
                "Or": [
                  {
                    "NumericEquals": 2,
                    "Variable": "$.DetermineSetValueNoRL.Length"
                  },
                  {
                    "And": [
                      {
                        "NumericEquals": 1,
                        "Variable": "$.DetermineSetValueNoRL.Length"
                      },
                      {
                        "IsNull": false,
                        "Variable": "$.DetermineSetValueNoRL.ZerothElement.Id"
