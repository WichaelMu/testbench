              "ProcessorConfig": {
                "ExecutionType": "STANDARD",
                "Mode": "DISTRIBUTED"
              },
              "StartAt": "NoRLCheck-RL-Code",
              "States": {
                "NoRLCheck-RL-Code": {
                  "Type": "Choice",
                  "Choices": [
                    {
                      "StringEqualsPath": "$.InterpolatedCourseSisId",
